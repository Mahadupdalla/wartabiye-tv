    "name": "Wartabiye TV",
    "slug": "wartabiye-tv",
    "description": "Wararka Soomaaliya, Bariga Afrika, caalamka iyo ciyaaraha, sagaal luqadood. The same news as wartabiyetv.com.",
    "version": "1.3.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "wartabiye",
    "userInterfaceStyle": "automatic",
    "primaryColor": "#037BDC",
    "backgroundColor": "#f4f7fb",
    "ios": {
      "bundleIdentifier": "com.wartabiyetv.app",
      "buildNumber": "2",
      "supportsTablet": true,
      "associatedDomains": [
        "applinks:www.wartabiyetv.com",
        "applinks:wartabiyetv.com"
      ],
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "UIBackgroundModes": [
          "remote-notification"
        ]
      }
    },
